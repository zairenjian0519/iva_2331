#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE=${AI_MODEL_MONITOR_CONFIG:-/etc/ai-model-monitor.conf}
STATE_DIR=${AI_MODEL_MONITOR_STATE_DIR:-/run/ai-model-monitor}

ACTIVE_PID=
ACTIVE_SNAPSHOT_KEY=
ACTIVE_SNAPSHOTTER=
CLEANING=0

log() { printf '[ai-model-monitor] %s\n' "$*"; }
fail() { log "ERROR: $*"; return 1; }

load_config() {
    [ -r "$CONFIG_FILE" ] || { log "ERROR: cannot read $CONFIG_FILE"; exit 1; }
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
    : "${NAMESPACE:?NAMESPACE is required}"
    : "${CONTAINER_NAME:?CONTAINER_NAME is required}"
    : "${CONTAINER_MODEL_DIR:?CONTAINER_MODEL_DIR is required}"
    : "${ROOTFS_DIR:?ROOTFS_DIR is required}"
    : "${HOST_MODEL_DIR:?HOST_MODEL_DIR is required}"
    : "${BUNDLE_MANIFEST:?BUNDLE_MANIFEST is required}"
    : "${ENGINE_UNIT:=ai_engine.service}"
    : "${SERVER_UNIT:=ai_server.service}"
    : "${POLL_INTERVAL_SEC:=2}"
    : "${SERVICE_START_TIMEOUT_SEC:=90}"
    : "${SERVICE_STOP_TIMEOUT_SEC:=20}"
    : "${UNMOUNT_RETRY_COUNT:=10}"
}

validate_config() {
    local command_name value unit
    [ "$(id -u)" -eq 0 ] || { log "ERROR: must run as root"; exit 1; }
    for command_name in ctr systemctl mount umount mountpoint findmnt stat awk sed grep find flock systemd-notify sha256sum; do
        command -v "$command_name" >/dev/null || { log "ERROR: missing command: $command_name"; exit 1; }
    done
    for value in "$NAMESPACE" "$CONTAINER_NAME" "$CONTAINER_MODEL_DIR" "$ROOTFS_DIR" "$HOST_MODEL_DIR"; do
        case "$value" in *[[:space:]]*) log "ERROR: whitespace is not supported: $value"; exit 1 ;; esac
    done
    case "$CONTAINER_MODEL_DIR:$ROOTFS_DIR:$HOST_MODEL_DIR" in /*:/*:/*) ;; *) log "ERROR: paths must be absolute"; exit 1 ;; esac
    for unit in "$ENGINE_UNIT" "$SERVER_UNIT"; do
        [ "$(systemctl show "$unit" -p LoadState --value 2>/dev/null)" = loaded ] || {
            log "ERROR: systemd unit is not loaded: $unit"; exit 1;
        }
    done
    mkdir -p "$STATE_DIR" "$ROOTFS_DIR" "$HOST_MODEL_DIR"
}

acquire_lock() {
    exec 9>"$STATE_DIR/monitor.lock"
    flock -n 9 || { log "ERROR: another monitor instance is reconciling state"; return 1; }
}

container_pid() {
    ctr --namespace "$NAMESPACE" tasks list 2>/dev/null |
        awk -v name="$CONTAINER_NAME" 'NR > 1 && $1 == name && $3 == "RUNNING" { print $2; exit }'
}

load_snapshot_info() {
    local info
    info=$(ctr --namespace "$NAMESPACE" containers info "$CONTAINER_NAME" 2>/dev/null) || return 1
    CURRENT_SNAPSHOT_KEY=$(printf '%s\n' "$info" | sed -n 's/.*"SnapshotKey": "\([^"]*\)".*/\1/p')
    CURRENT_SNAPSHOTTER=$(printf '%s\n' "$info" | sed -n 's/.*"Snapshotter": "\([^"]*\)".*/\1/p')
    [ -n "$CURRENT_SNAPSHOT_KEY" ] && [ -n "$CURRENT_SNAPSHOTTER" ]
}

unit_active() { systemctl is-active --quiet "$1"; }

stop_unit() {
    local unit=$1 state attempt
    systemctl stop --no-block "$unit" >/dev/null 2>&1 || true
    for attempt in $(seq 1 "$SERVICE_STOP_TIMEOUT_SEC"); do
        state=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
        case "$state" in inactive|failed|'') return 0 ;; esac
        sleep 1
    done
    systemctl kill --kill-who=all --signal=SIGKILL "$unit" >/dev/null 2>&1 || true
    systemctl stop --no-block "$unit" >/dev/null 2>&1 || true
    sleep 1
    state=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
    case "$state" in inactive|failed|'') return 0 ;; esac
    fail "$unit is still active after SIGKILL"
}

stop_inference() {
    local failed=0
    # Stop producers before the HTTP consumer on RK3588.
    stop_unit "$ENGINE_UNIT" || failed=1
    stop_unit "$SERVER_UNIT" || failed=1
    return "$failed"
}

start_unit_checked() {
    local unit=$1 attempt state
    systemctl start --no-block "$unit" || true
    for attempt in $(seq 1 "$SERVICE_START_TIMEOUT_SEC"); do
        state=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
        case "$state" in
            active) return 0 ;;
            failed) fail "$unit entered failed state"; return 1 ;;
        esac
        systemd-notify WATCHDOG=1 || true
        sleep 1
    done
    fail "timeout waiting for $unit"
}

start_inference() {
    # ai_engine.service is ordered After=ai_server.service on this board.
    start_unit_checked "$SERVER_UNIT" || { stop_inference || true; return 1; }
    start_unit_checked "$ENGINE_UNIT" || { stop_inference || true; return 1; }
    log "$SERVER_UNIT and $ENGINE_UNIT are active"
}

unmount_path() {
    local path=$1 attempt
    mountpoint -q "$path" || return 0
    for attempt in $(seq 1 "$UNMOUNT_RETRY_COUNT"); do
        if umount "$path"; then log "unmounted $path"; return 0; fi
        sleep 1
    done
    command -v fuser >/dev/null && fuser -vm "$path" 2>&1 || true
    fail "failed to unmount $path"
}

deactivate() {
    local failed=0
    if ! stop_inference; then
        log "ERROR: inference is still active; preserving mounts"
        return 1
    fi
    unmount_path "$HOST_MODEL_DIR" || failed=1
    unmount_path "$ROOTFS_DIR" || failed=1
    ACTIVE_PID=
    ACTIVE_SNAPSHOT_KEY=
    ACTIVE_SNAPSHOTTER=
    rm -f -- "$STATE_DIR/active.env"
    return "$failed"
}

mount_snapshot() {
    local snapshot_key=$1 snapshotter=$2 mount_line prefix options
    mountpoint -q "$ROOTFS_DIR" && { fail "$ROOTFS_DIR is already mounted"; return 1; }
    [ -z "$(find "$ROOTFS_DIR" -mindepth 1 -print -quit 2>/dev/null)" ] || {
        fail "$ROOTFS_DIR must be empty"; return 1;
    }
    [ "$snapshotter" = overlayfs ] || { fail "unsupported snapshotter: $snapshotter"; return 1; }
    mount_line=$(ctr --namespace "$NAMESPACE" snapshots --snapshotter "$snapshotter" mounts "$ROOTFS_DIR" "$snapshot_key") || return 1
    prefix="mount -t overlay overlay $ROOTFS_DIR -o "
    case "$mount_line" in "$prefix"*) options=${mount_line#"$prefix"} ;; *) fail "unexpected mount command: $mount_line"; return 1 ;; esac
    mount -t overlay overlay "$ROOTFS_DIR" -o "$options"
    mount --make-private "$ROOTFS_DIR"
    mount -o remount,ro "$ROOTFS_DIR"
    log "mounted snapshot $snapshot_key at $ROOTFS_DIR"
}

verify_bundle() {
    local source_path="$ROOTFS_DIR$CONTAINER_MODEL_DIR"
    [ -d "$source_path" ] || { fail "model directory is absent: $source_path"; return 1; }
    [ -f "$source_path/$BUNDLE_MANIFEST" ] || { fail "bundle manifest is absent"; return 1; }
    (cd "$source_path" && sha256sum -c "$BUNDLE_MANIFEST" --quiet) || {
        fail "model bundle checksum verification failed"; return 1;
    }
    log "model bundle checksums verified"
}

mount_models() {
    local source_path="$ROOTFS_DIR$CONTAINER_MODEL_DIR"
    mountpoint -q "$HOST_MODEL_DIR" && { fail "$HOST_MODEL_DIR is already mounted"; return 1; }
    [ -z "$(find "$HOST_MODEL_DIR" -mindepth 1 -print -quit 2>/dev/null)" ] || {
        fail "$HOST_MODEL_DIR must be empty before mounting"; return 1;
    }
    mount --bind "$source_path" "$HOST_MODEL_DIR"
    mount --make-private "$HOST_MODEL_DIR"
    mount -o remount,bind,ro,nosuid,nodev "$HOST_MODEL_DIR"
    log "mounted models read-only at $HOST_MODEL_DIR"
}

mount_is_read_only() {
    findmnt -n -o OPTIONS -M "$1" 2>/dev/null | tr ',' '\n' | grep -qx ro
}

mounts_valid() {
    local source_path="$ROOTFS_DIR$CONTAINER_MODEL_DIR"
    mountpoint -q "$ROOTFS_DIR" && mountpoint -q "$HOST_MODEL_DIR" || return 1
    mount_is_read_only "$ROOTFS_DIR" && mount_is_read_only "$HOST_MODEL_DIR" || return 1
    [ -f "$source_path/$BUNDLE_MANIFEST" ] || return 1
    [ "$(stat -c '%d:%i' "$source_path")" = "$(stat -c '%d:%i' "$HOST_MODEL_DIR")" ]
}

write_state() {
    cat > "$STATE_DIR/active.env" <<EOF
ACTIVE_PID=$ACTIVE_PID
ACTIVE_SNAPSHOT_KEY=$ACTIVE_SNAPSHOT_KEY
ACTIVE_SNAPSHOTTER=$ACTIVE_SNAPSHOTTER
EOF
}

activate() {
    local expected_pid=$1 current_pid
    load_snapshot_info || { fail "cannot read container snapshot metadata"; return 1; }
    mount_snapshot "$CURRENT_SNAPSHOT_KEY" "$CURRENT_SNAPSHOTTER" || return 1
    verify_bundle || { unmount_path "$ROOTFS_DIR" || true; return 1; }
    mount_models || { unmount_path "$ROOTFS_DIR" || true; return 1; }
    current_pid=$(container_pid || true)
    if [ "$current_pid" != "$expected_pid" ]; then
        deactivate || true
        fail "container changed while mounting"
        return 1
    fi
    ACTIVE_PID=$expected_pid
    ACTIVE_SNAPSHOT_KEY=$CURRENT_SNAPSHOT_KEY
    ACTIVE_SNAPSHOTTER=$CURRENT_SNAPSHOTTER
    write_state
    start_inference || return 1
    [ "$(container_pid || true)" = "$expected_pid" ] || {
        deactivate || true
        fail "container stopped while inference was starting"
        return 1
    }
    log "inference is active for $CONTAINER_NAME (pid $expected_pid)"
}

reconcile() {
    local pid
    pid=$(container_pid || true)
    if [ -z "$pid" ]; then
        if [ -n "$ACTIVE_PID" ] || mountpoint -q "$HOST_MODEL_DIR" || mountpoint -q "$ROOTFS_DIR" || unit_active "$ENGINE_UNIT" || unit_active "$SERVER_UNIT"; then
            log "$CONTAINER_NAME is not running; failing closed"
            deactivate || true
        fi
        systemd-notify --status="Model container stopped; inference disabled" || true
        return
    fi
    if ! load_snapshot_info; then
        deactivate || true
        return
    fi
    if [ "$ACTIVE_PID" = "$pid" ] && [ "$ACTIVE_SNAPSHOT_KEY" = "$CURRENT_SNAPSHOT_KEY" ] && [ "$ACTIVE_SNAPSHOTTER" = "$CURRENT_SNAPSHOTTER" ] && mounts_valid; then
        systemd-notify --status="Models mounted from $CONTAINER_NAME (pid $pid)" || true
        return
    fi
    log "detected model container pid $pid; rebuilding mounts"
    deactivate || return
    pid=$(container_pid || true)
    [ -n "$pid" ] && activate "$pid" || true
}

check_ready() {
    local role=${1:-engine}
    [ -n "$(container_pid || true)" ] || { fail "$CONTAINER_NAME is not running"; return 1; }
    mounts_valid || { fail "model mounts are not ready"; return 1; }
    case "$role" in engine|server) ;; *) fail "unknown role: $role"; return 1 ;; esac
}

status_command() {
    local pid
    pid=$(container_pid || true)
    if [ -n "$pid" ]; then
        printf 'container: running (pid %s)\n' "$pid"
    else
        echo 'container: stopped'
    fi
    printf 'rootfs: '; mountpoint -q "$ROOTFS_DIR" && findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS -M "$ROOTFS_DIR" || echo absent
    printf 'models: '; mountpoint -q "$HOST_MODEL_DIR" && findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS -M "$HOST_MODEL_DIR" || echo absent
    printf 'server: %s\n' "$(systemctl is-active "$SERVER_UNIT" 2>/dev/null || true)"
    printf 'engine: %s\n' "$(systemctl is-active "$ENGINE_UNIT" 2>/dev/null || true)"
}

on_exit() {
    [ "$CLEANING" -eq 0 ] || return
    CLEANING=1
    trap - EXIT INT TERM
    log "monitor is stopping; disabling inference"
    deactivate || true
}

on_signal() {
    on_exit
    exit 0
}

run_daemon() {
    trap on_exit EXIT
    trap on_signal INT TERM
    log "performing startup reconciliation"
    deactivate || return 1
    systemd-notify --ready --status="Starting model reconciliation"
    reconcile
    while :; do
        systemd-notify WATCHDOG=1 || true
        sleep "$POLL_INTERVAL_SEC"
        reconcile
    done
}

load_config
validate_config
case "${1:-run}" in
    run) acquire_lock; run_daemon ;;
    once) acquire_lock; reconcile ;;
    cleanup) acquire_lock; deactivate ;;
    check-ready) check_ready "${2:-engine}" ;;
    status) status_command ;;
    verify-bundle) verify_bundle ;;
    *) echo "usage: $0 {run|once|cleanup|check-ready [engine|server]|status|verify-bundle}" >&2; exit 2 ;;
esac
