[Unit]
Description=KyScene ZLMediaKit media server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=forlinx
Group=forlinx
WorkingDirectory=/userdata/sps_test/iva-kyscene/zlmediakit
ExecStart=/userdata/sps_test/iva-kyscene/zlmediakit/MediaServer
Restart=on-failure
RestartSec=5
UMask=0027
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
